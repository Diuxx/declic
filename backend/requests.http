@apiUrl = http://localhost:8080
@ollamaUrl = http://localhost:11434
@model = qwen3.5:4b

### Health check backend
GET {{apiUrl}}/api/v1/health
Accept: application/json

### Test correction (sans explications)
POST {{apiUrl}}/api/v1/correction
Content-Type: application/json
Accept: application/json

{
  "text": "J'ai fait une faute de frappe dans cette phrase.",
  "language": "fr",
  "includeExplanations": false
}

### Test correction (avec explications)
POST {{apiUrl}}/api/v1/correction
Content-Type: application/json
Accept: application/json

{
  "text": "Je sui aller au marcher hier et j'ai acheter des pomes.",
  "language": "fr",
  "includeExplanations": true
}

### Vérifier Ollama (optionnel)
GET {{ollamaUrl}}/api/tags

### Test direct Ollama (optionnel)
POST {{ollamaUrl}}/api/chat
Content-Type: application/json

{
  "model": "{{model}}",
  "stream": false,
  "messages": [
    {
      "role": "user",
      "content": "Corrige: Je parl pa bien le francais"
    }
  ]
}




